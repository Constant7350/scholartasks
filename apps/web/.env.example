# From your Supabase project: Project Settings > API Keys.
# Use the publishable key (sb_publishable_...). Never put the secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only, for the daily reminder emails (set these in Vercel, never in the browser):
# SUPABASE_SECRET_KEY=sb_secret_...   (Supabase > Project Settings > API Keys > Secret keys)
# RESEND_API_KEY=re_...               (Resend > API Keys, sending access, scholartasks.com)
# CRON_SECRET=any-long-random-string  (Vercel sends this to the cron route automatically)

# Server-only, for the AI counselor (set in Vercel, never in the browser):
# ANTHROPIC_API_KEY=sk-ant-...        (console.anthropic.com > API Keys)
